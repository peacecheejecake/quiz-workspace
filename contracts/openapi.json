    "/api/v1/workspaces/{workspace_id}/archive": {
      "post": {
        "description": "Make the workspace read-only (owner). Repeating it returns the archived workspace.",
        "operationId": "archiveWorkspace",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
