# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.
# Variable names follow docs/deployment.md §6.
#
# Non-secret values below are the defaults of the local stack (`make infra-up`: Supabase CLI
# ports from supabase/config.toml, Qdrant/Redis from infra/compose.yaml). Keys printed by
# `pnpm exec supabase status` go only into your git-ignored `.env`, never into this file.

# ---------------------------------------------------------------------------
# Public (browser-exposed). Safe to ship to the client; access is still decided by
# JWT / RLS / the FastAPI authorization boundary. Only these may use NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# FastAPI base URL the browser calls with a Bearer token (`make api-dev` default port).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Cloudflare Turnstile sitekey (docs/auth.md §5.1). Set = the auth forms show the CAPTCHA widget;
# empty = CAPTCHA off. Locally: Cloudflare's always-passes test key (E2E fakes the widget; the local
# Supabase does not verify tokens). Deployments: a real widget key (production refuses test keys).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# Server-only (API / worker / Next.js server). NEVER prefix with NEXT_PUBLIC_,
# never log, never put in URLs.
# ---------------------------------------------------------------------------
# The API connects as the least-privilege `quiz_api` role (supabase/migrations creates it NOLOGIN).
# One-time local step after `make infra-up` (re-run if the DB container was recreated):
#   psql "postgresql://postgres:postgres@127.0.0.1:54322/postgres" \
#     -c "alter role quiz_api with login password 'change-me-local'"
# Migrations, `make db-reset` and `make db-test` go through the Supabase CLI, which uses its own
# admin connection; nothing in the app reads a separate admin URL.
DATABASE_URL=postgresql://quiz_api:change-me-local@127.0.0.1:54322/postgres
# The worker connects as its own least-privilege `quiz_worker` role (async_jobs only; created
# NOLOGIN by supabase/migrations) and never reads DATABASE_URL. Set -> Postgres JobStore; unset ->
# in-memory store locally (WORKER_JOB_STORE_PATH selects SQLite). Required in preview/production.
# One-time local step after `make infra-up` (re-run if the DB container was recreated):
#   psql "postgresql://postgres:postgres@127.0.0.1:54322/postgres" \
#     -c "alter role quiz_worker with login password 'change-me-local'"
WORKER_DATABASE_URL=postgresql://quiz_worker:change-me-local@127.0.0.1:54322/postgres
SUPABASE_SECRET_KEY=
# Supabase Auth access-token verification (A1.2). Tokens are signed with the asymmetric (ES256)
# key from `make auth-keys`; the API verifies them against the JWKS, never a shared secret.
# Locally the issuer is <SUPABASE_URL>/auth/v1 (`[auth] external_url` in supabase/config.toml).
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Browser origins allowed to call the API (comma-separated scheme://host[:port], no wildcard,
# ASCII/punycode only: what `new URL(origin).origin` prints in a browser).
# Unset → http://127.0.0.1:3000 and http://localhost:3000; required (https) when APP_ENV is
# preview/production (docs/deployment.md §6.1).
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
SUPABASE_JWT_AUDIENCE=authenticated
# Public web origin for owner share URLs (`<origin>/share/{id}#k=<secret>`, S1a). Unset → the
# first CORS origin; must be https:// when APP_ENV is preview/production.
# WEB_ORIGIN=http://127.0.0.1:3000
# Guest share sessions (S1b): HMAC key of the `quiz_share_session` cookie, >= 32 chars
# (`openssl rand -base64 32`), identical on every API replica. Unset locally/in tests → random
# per-process key (sessions end on restart); unset in preview/production → /shared routes 503.
SHARE_SESSION_SECRET=
# SHARE_SESSION_TTL_SECONDS=14400          # <= 28800 (8 h)
# SHARE_EXCHANGE_RATE_LIMIT_PER_MINUTE=20  # per client and link, in-process (0 disables)
# SHARE_EXCHANGE_LINK_RATE_LIMIT_PER_MINUTE=300  # ceiling per link across all clients
# Web relay → API client identity for the per-client limits (API and Next.js server, same value,
# >= 32 chars, `openssl rand -base64 32`). The relay hashes the client address from the edge
# header named by RELAY_CLIENT_IP_HEADER (one the hosting edge overwrites, e.g. x-real-ip) and
# signs it. Unset locally → the API keys on the socket peer; preview/production → /shared 503.
RELAY_CLIENT_SECRET=
# RELAY_CLIENT_IP_HEADER=x-real-ip
# SHARE_FORK_RATE_LIMIT_PER_MINUTE=5      # fork starts per user, in-process (0 disables)
# Next.js server: HMAC key for the `/reset-password` recovery-session marker (A2.2). Generate with
# `openssl rand -base64 32` (≥ 32 chars). Required whenever APP_ENV is not local/test; left empty
# locally, the web server uses a random per-process key (markers expire on restart).
AUTH_RECOVERY_MARKER_SECRET=
QDRANT_URL=http://127.0.0.1:6333
# Worker document jobs (M3.2b; apps/worker/src/quiz_worker/settings.py). The worker also reads
# SUPABASE_SECRET_KEY + NEXT_PUBLIC_SUPABASE_URL (or SUPABASE_URL) for private Storage and QDRANT_*.
# APP_ENV=test (E2E) selects the fixture-truth parser and the fake embedder with the
# `E2E-FAIL-INDEXING` failure marker; otherwise Docling + Qwen3-Embedding.
# WORKER_PARSER=auto            # auto | docling | fake
# WORKER_EMBEDDER=auto          # auto | qwen3 | workers_ai | fake
# Cloudflare Workers AI embeddings (WORKER_EMBEDDER=workers_ai, staging/production; M7.4b). Sends
# chunk text and queries to Cloudflare. Server-only (api + worker), never NEXT_PUBLIC_ / web.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # account API token with Workers AI permission only
# CLOUDFLARE_AI_BATCH_SIZE=16
# CLOUDFLARE_AI_TIMEOUT_SECONDS= # api 5 (then BM25 fallback), worker 30
# WORKER_MODELS_OFFLINE=false   # true: never contact the HF Hub (pre-downloaded weights)
# WORKER_PDF_MAX_PAGES=1500
# WORKER_PARSE_TIMEOUT_SECONDS=1200
# WORKER_PARSE_QUEUE_MAX_SIZE=8  # Docling pages in flight (memory bound, M7.4c)
# WORKER_PARSE_PAGE_BATCH_SIZE=4 # pages per Docling model batch (<= queue size)
# Workspace search (M3.6a): the API embeds queries with the worker's embedder, so it reads the
# same APP_ENV / WORKER_EMBEDDER / WORKER_MODELS_OFFLINE / QDRANT_COLLECTION_PREFIX values.
# QDRANT_COLLECTION_PREFIX=     # namespaces collections (previews, test sessions); API = worker
# SEARCH_RATE_LIMIT_PER_MINUTE=60  # per user, in-process (0 disables); SEARCH_RATE_BURST=20
# Empty for local Qdrant (no auth); required outside local.
QDRANT_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
LLM_API_KEY=

# ---------------------------------------------------------------------------
# E2E (Playwright, local / CI only). Use synthetic test accounts only.
# ---------------------------------------------------------------------------
E2E_BASE_URL=http://127.0.0.1:3000
# Local Mailpit (Supabase `[local_smtp]`): auth emails are read from its HTTP API in tests.
E2E_MAILPIT_URL=http://127.0.0.1:54324
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SHARE_URL=
E2E_FORK_SHARE_URL=
