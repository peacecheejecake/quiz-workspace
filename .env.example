# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.
# Variable names follow docs/deployment.md §6.
#
# Non-secret values below are the defaults of the local stack (`make infra-up`: Supabase CLI
# ports from supabase/config.toml, Qdrant/Redis from infra/compose.yaml). Keys printed by
# `pnpm exec supabase status` go only into your git-ignored `.env`, never into this file.

# ---------------------------------------------------------------------------
# Public (browser-exposed). Safe to ship to the client; access is still decided by
# JWT / RLS / the FastAPI authorization boundary. Only these may use NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# FastAPI base URL the browser calls with a Bearer token (`make api-dev` default port).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Server-only (API / worker / Next.js server). NEVER prefix with NEXT_PUBLIC_,
# never log, never put in URLs.
# ---------------------------------------------------------------------------
# The API connects as the least-privilege `quiz_api` role (supabase/migrations creates it NOLOGIN).
# One-time local step after `make infra-up` (re-run if the DB container was recreated):
#   psql "postgresql://postgres:postgres@127.0.0.1:54322/postgres" \
#     -c "alter role quiz_api with login password 'change-me-local'"
# Migrations, `make db-reset` and `make db-test` go through the Supabase CLI, which uses its own
# admin connection; nothing in the app reads a separate admin URL.
DATABASE_URL=postgresql://quiz_api:change-me-local@127.0.0.1:54322/postgres
SUPABASE_SECRET_KEY=
# Supabase Auth access-token verification (A1.2). Tokens are signed with the asymmetric (ES256)
# key from `make auth-keys`; the API verifies them against the JWKS, never a shared secret.
# Locally the issuer is <SUPABASE_URL>/auth/v1 (`[auth] external_url` in supabase/config.toml).
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
QDRANT_URL=http://127.0.0.1:6333
# Empty for local Qdrant (no auth); required outside local.
QDRANT_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
LLM_API_KEY=

# ---------------------------------------------------------------------------
# E2E (Playwright, local / CI only). Use synthetic test accounts only.
# ---------------------------------------------------------------------------
E2E_BASE_URL=http://127.0.0.1:3000
# Local Mailpit (Supabase `[local_smtp]`): auth emails are read from its HTTP API in tests.
E2E_MAILPIT_URL=http://127.0.0.1:54324
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SHARE_URL=
E2E_FORK_SHARE_URL=
