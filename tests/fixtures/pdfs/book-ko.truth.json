    {
      "id": "ch2-s2-heading",
      "type": "heading",
      "text": "2.2 여과와 소독",
      "section_id": "ch2-s2",
      "parts": [
        {
          "page": 4,
          "bbox": {
            "x0": 64.0,
            "y0": 473.45,
