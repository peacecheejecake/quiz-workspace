#!/usr/bin/env bash
# Rebuild the Qdrant document index from PostgreSQL published active revisions (M7.3).
#
#   scripts/reindex --all | --workspace <uuid>... [--dry-run] [--after <document uuid>]
#
# Thin wrapper over `python -m quiz_worker.reindex` (worker environment: WORKER_DATABASE_URL,
# QDRANT_URL / QDRANT_API_KEY / QDRANT_COLLECTION_PREFIX, APP_ENV / WORKER_EMBEDDER — the same
# values as the worker that keeps the index in sync). In the worker image run the module directly.
# Idempotent and resumable; see apps/worker/src/quiz_worker/reindex.py.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --no-sync python -m quiz_worker.reindex "$@"
