{
  "name": "quiz-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint . && prettier . --check && pnpm -r --if-present run lint",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "e2e": "playwright test",
    "e2e:trace": "node scripts/e2e-trace.ts",
    "e2e:log-audit": "node scripts/e2e-log-audit.ts",
    "e2e:artifact-audit": "node scripts/e2e-artifact-audit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "^10",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17",
    "prettier": "^3",
    "supabase": "2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
