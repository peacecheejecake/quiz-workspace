{
  "name": "quiz-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint . && prettier . --check && pnpm -r --if-present run lint",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "^10",
    "globals": "^17",
    "prettier": "^3",
    "supabase": "2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
